# AssetX backend configuration. Copy to .env and adjust as needed.

# SQLite file. Relative paths resolve from the repository root.
ASSETX_DATABASE_PATH=backend/data/assetx.db

# Built frontend. Used by FastAPI to serve the SPA when present.
ASSETX_FRONTEND_DIST=frontend/dist

# Minimum spacing between address refresh starts (the queue is sequential).
ASSETX_REFRESH_INTERVAL_SECONDS=3

# Outbound HTTP timeout for RPC and price providers.
ASSETX_REQUEST_TIMEOUT_SECONDS=20

# Prices are cached briefly so a refresh-all batch does not hammer the API.
ASSETX_PRICE_CACHE_SECONDS=15

# Dev server origins. Comma separate. Use * to allow all.
ASSETX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional comma-separated overrides for public endpoints.
# ASSETX_ETHEREUM_RPCS=https://ethereum-rpc.publicnode.com,https://eth.drpc.org
# ASSETX_SOLANA_RPCS=https://api.mainnet-beta.solana.com,https://solana-rpc.publicnode.com
# ASSETX_BITCOIN_APIS=https://blockstream.info/api,https://mempool.space/api
# ASSETX_NERVOS_RPCS=https://mainnet.ckb.dev/rpc,https://mainnet.ckbapp.dev/rpc
# ASSETX_COSMOS_APIS=https://cosmos-rest.publicnode.com,https://rest.cosmos.directory/cosmoshub
# ASSETX_STACKS_APIS=https://api.hiro.so,https://api.mainnet.hiro.so

# Set to false to run the API without the background refresh worker.
ASSETX_START_WORKER=true
